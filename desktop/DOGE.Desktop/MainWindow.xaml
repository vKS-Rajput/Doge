                                <TextBlock Text="20 req / sec" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Scope Enforcement" FontSize="9.5" Foreground="#CBD5E1" />
                                <TextBlock Text="STRICT (Subdomains &amp; IPs)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== RIGHT INSPECTOR / AI PANEL ==================== -->
            <Border Grid.Column="2" Background="#070A14" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,0,0,0" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Tab Selector Header -->
                        <RowDefinition Height="28" />
                        <!-- Tab Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab Switcher -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="tabBtnInspector" Background="#0E2238" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="OnTabInspectorClick">
                                <TextBlock Text="🔍 INSPECTOR" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                            </Border>
                            <Border x:Name="tabBtnAi" Background="Transparent" CornerRadius="4" Padding="8,3" Cursor="Hand" MouseLeftButtonDown="OnTabAiClick">
                                <TextBlock Text="🤖 AI COPILOT" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <!-- Panel Toggle -->
                        <TextBlock Text="⇥" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnToggleRightPanelClick" />
                    </Grid>

                    <!-- TAB 1: INSPECTOR PANEL -->
                    <Grid x:Name="panelInspector" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="SELECTED ENTITY SPECIFICATION" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />

                                <!-- Selected Target / Node Header -->
                                <Border Background="#090E1A" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="txtDetailHost" Text="example.com" FontSize="12.5" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <TextBlock x:Name="txtDetailIp" Text="192.168.1.10" FontSize="9.5" Foreground="#64748B" FontFamily="Consolas" Margin="0,2,0,0" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="Active Research Subject" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Technical Details -->
                                <TextBlock Text="TELEMETRY &amp; STATE" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,4" />
                                <Border Background="#090E1A" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Technology" FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="Nginx 1.24.0" FontSize="9" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="WAF Detection" FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="Not Detected" FontSize="9" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Open Ports" FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="80, 443, 22, 3306" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="OS Fingerprint" FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="Linux (Ubuntu)" FontSize="9" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Risk Score" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" />
                                            <TextBlock Text="8.7 / 10" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Tool Trigger -->
                                <TextBlock Text="DIRECT WORKSTATION ACTIONS" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,4,0,4" />
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Content="Scan Nmap" Style="{StaticResource CyberButton}" Margin="1" Click="OnRunNmapAction" />
                                    <Button Content="Fuzz Dir" Style="{StaticResource CyberButton}" Margin="1" Click="OnDirScanAction" />
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="Subdomains" Style="{StaticResource CyberButton}" Margin="1" Click="OnSubdomainsAction" />
                                    <Button Content="Exploit DB" Style="{StaticResource CyberButton}" Margin="1" Click="OnExploitSearchAction" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Help Note -->
                        <TextBlock Grid.Row="1" Text="Click any graph node or finding to inspect" FontSize="7.5" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </Grid>

                    <!-- TAB 2: AI COPILOT PANEL -->
                    <Grid x:Name="panelAi" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chat Messages -->
                        <ScrollViewer x:Name="aiChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                            <StackPanel x:Name="aiChatPanel">
                                <Border Background="#0E1626" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                    <TextBlock Text="Greetings, Researcher. I am your DOGE Autonomous Security Copilot. I analyze information gain, synthesize experiment falsifications, and verify causal invariants." Foreground="#E2E8F0" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Quick Suggestion Chips -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button Content="Analyze scan results &amp; attack paths" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,1.5" Click="OnSuggestionClick" />
                            <Button Content="Explain SQL injection on /login" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,1.5" Click="OnSuggestionClick" />
                            <Button Content="Synthesize experiment for H-184" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,1.5" Click="OnSuggestionClick" />
                            <Button Content="Generate tamper-proof PoC report" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,1.5" Click="OnSuggestionClick" />
                        </StackPanel>

                        <!-- Input Box -->
                        <Border Grid.Row="2" Background="#0C1220" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="5">
                            <Grid Margin="6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtAiInput" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="10" VerticalAlignment="Center" Text="Ask anything about security..." GotFocus="OnAiInputGotFocus" LostFocus="OnAiInputLostFocus" KeyDown="OnAiInputKeyDown" />
                                <Button Grid.Column="1" Content="➤" Style="{StaticResource CyberPrimaryButton}" Width="24" Height="24" Padding="0,0,0,0" Margin="4,0,0,0" Click="OnSendAiMessageClick" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="3" Text="Powered by local/online LLM (Offline First)" FontSize="7.5" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="#04060B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DOGE v1.0.0" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,12,0" />
                    <TextBlock Text="● Named Pipe (\\.\pipe\doge-ipc)" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" Margin="0,0,12,0" />
                    <TextBlock Text="WSL2: " FontSize="8.5" Foreground="#64748B" />
                    <TextBlock Text="kali-linux (Online)" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" Margin="0,0,12,0" />
                    <TextBlock Text="Target: " FontSize="8.5" Foreground="#64748B" />
                    <TextBlock x:Name="txtStatusWorkspace" Text="example.com" FontSize="8.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,12,0" />
                    <TextBlock Text="Attestation: " FontSize="8.5" Foreground="#64748B" />
                    <TextBlock Text="4 Merkle Proofs Sealed" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" Margin="0,0,12,0" />
                    <TextBlock Text="Offline-First (100% Local)" FontSize="8" Foreground="#64748B" />
                </StackPanel>

                <!-- Right Quote -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="&quot;Knowledge is the ultimate exploit.&quot; — DOGE" FontSize="8" FontStyle="Italic" Foreground="#475569" />
            </Grid>
        </Border>

        <!-- ==================== 4. HUMAN-IN-THE-LOOP APPROVAL MODAL ==================== -->
        <Grid x:Name="gridApprovalModal" Grid.RowSpan="3" Panel.ZIndex="1000" Visibility="Collapsed" Background="#E6030712">
            <Border Background="#090E1A" BorderBrush="#F43F5E" BorderThickness="1.5" CornerRadius="8" Width="780" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Target & Risk Badges -->
                        <RowDefinition Height="Auto" />
                        <!-- Invariant / Provenance -->
                        <RowDefinition Height="Auto" />
                        <!-- Stimulus / Payload Preview -->
                        <RowDefinition Height="*" />
                        <!-- Operator Notes Input -->
                        <RowDefinition Height="Auto" />
                        <!-- Action Buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#3B1212" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Text="⚠️" FontSize="18" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="HUMAN-IN-THE-LOOP APPROVAL GATE" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                                    <Border Background="#450A0A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="PAUSED FOR OPERATOR AUTHORIZATION" FontSize="8" FontWeight="Bold" Foreground="#F43F5E" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="txtGateTitle" Text="Authorize Exploit Verification Probe" FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource CyberButton}" Width="24" Height="24" Padding="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseApprovalModalClick" />
                    </Grid>

                    <!-- Target & Risk Bar -->
                    <Border Grid.Row="1" Background="#060913" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TARGET ENDPOINT" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtGateTarget" Text="https://example.com/api/v1/auth" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RISK LEVEL" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <Border Background="#450A0A" CornerRadius="3" Padding="6,2" Margin="0,2,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtGateRisk" Text="HIGH RISK" FontSize="8.5" FontWeight="Bold" Foreground="#F43F5E" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CONFIDENCE" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtGateConfidence" Text="95.0% Epistemic" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="PROVER ENGINE" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock x:Name="txtGateTool" Text="CEGAR Sandbox" FontSize="9.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Invariant / Reason -->
                    <Border Grid.Row="2" Background="#0D1527" BorderBrush="#1D3050" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ENSEMBLE RESEARCH COUNCIL DELIBERATION &amp; REASONING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4" />
                            <TextBlock x:Name="txtGateReason" Text="The 50+ Researcher Ensemble Council reached 95% consensus that the target displays invariant divergence allowing authorization bypass." FontSize="9.5" Foreground="#E2E8F0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Technical Stimulus / Payload Preview -->
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="PROPOSED VERIFICATION STIMULUS / PAYLOAD" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBlock Text="(Non-Destructive Invariant Falsification)" FontSize="8" Foreground="#64748B" Margin="6,0,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="#030509" BorderBrush="#152033" BorderThickness="1" CornerRadius="5" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <TextBox x:Name="txtGateCommand" Text="GET /api/v1/auth/verify?bypass=invariant_check HTTP/1.1&#x0a;Host: example.com&#x0a;X-Doge-Attestation: true" Background="Transparent" Foreground="{StaticResource BrushEmerald}" FontFamily="Consolas" FontSize="9.5" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Operator Notes Input -->
                    <Border Grid.Row="4" Background="#060913" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Operator Directives: " FontSize="8.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="txtOperatorNotes" Grid.Column="1" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="9.5" VerticalAlignment="Center" Text="Authorized for verification within stated rate limit" />
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="⏱ Postpone / Stand By" Style="{StaticResource CyberButton}" Height="34" Width="150" Click="OnPostponeGateClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✕ REJECT / ABORT PROBE" Style="{StaticResource CyberButton}" BorderBrush="#F43F5E" Foreground="#F43F5E" Height="34" Width="180" Margin="0,0,10,0" Click="OnRejectGateClick" />
                            <Button Content="✓ AUTHORIZE EXECUTION" Style="{StaticResource CyberPrimaryButton}" Height="34" Width="200" Click="OnApproveGateClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
