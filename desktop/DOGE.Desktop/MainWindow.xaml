<Window x:Class="DOGE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DOGE.Desktop.Controls"
        Title="DOGE — Security Research Workstation"
        Height="980" Width="1540" MinHeight="750" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBgObsidian}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command Bar -->
            <RowDefinition Height="46" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP COMMAND BAR ==================== -->
        <Border Grid.Row="0" Background="#0A0E18" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Search / Command Palette -->
                    <ColumnDefinition Width="280" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="*" />
                    <!-- Tagline & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DOGE Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="🐺" FontSize="20" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="D O G E" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Text="SECURITY RESEARCH WORKSTATION" FontSize="7.5" FontWeight="SemiBold" Foreground="#475569" />
                    </StackPanel>
                </StackPanel>

                <!-- Search / Command Palette Input -->
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Height="28" Margin="0,0,15,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="11" VerticalAlignment="Center" Text="Ctrl + Shift + P  Search anything..." GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" KeyDown="OnSearchKeyDown" />
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="+ New Target" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnNewTargetClick" />
                    <Button Content="⚡ Quick Scan" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnQuickScanClick" />
                    <Button Content="👁 Deep Recon" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnDeepReconClick" />
                    <Button Content="🎯 Exploit Path" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnExploitPathClick" />
                    <Button Content="🤖 AI Assistant" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnAiAssistantClick" />
                    <Button Content="📄 Report" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Click="OnReportClick" />
                    <!-- Primary Glowing Start Button -->
                    <Button x:Name="btnStart" Content="▶  Start" Style="{StaticResource CyberPrimaryButton}" Width="85" Height="28" Click="OnStartResearchClick" />
                </StackPanel>

                <!-- Tagline and Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hack Smarter, Go Deeper." FontSize="10.5" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Custom Window Buttons -->
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource CyberButton}" Width="28" Height="24" Padding="0" Click="OnMinimizeClick" Margin="0,0,3,0" />
                        <Button Content="□" Style="{StaticResource CyberButton}" Width="28" Height="24" Padding="0" Click="OnMaximizeClick" Margin="0,0,3,0" />
                        <Button Content="✕" Style="{StaticResource CyberButton}" Width="28" Height="24" Padding="0" Click="OnCloseClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN COCKPIT BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Navigation Rail -->
                <ColumnDefinition Width="170" />
                <!-- Central Workspace -->
                <ColumnDefinition Width="*" />
                <!-- Right AI Panel -->
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="#060912" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="8,8,8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="navPanel">
                            <!-- Nav Items matching screenshot -->
                            <Border x:Name="navDashboard" Background="#0E2238" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⊞" Foreground="{StaticResource BrushCyan}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Dashboard" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navRecon" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🔍" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Recon" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navTargets" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🎯" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Targets" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navVulns" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🛡" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Vulnerabilities" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navExploit" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⚡" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Exploitation" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navPostExploit" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⚙" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Post-Exploit" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navWorldMap" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🌐" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="World Map" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navEvidence" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="📜" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Evidence" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navReports" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="📑" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Reports" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navAutomation" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🔗" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Automation" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navAi" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🤖" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="AI Assistant" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navPlaybooks" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="📖" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Playbooks" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navToolbox" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🧰" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Toolbox" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navTerminal" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="💻" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Terminal" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navNotes" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="📝" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Notes" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navSettings" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⚙" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Settings" Foreground="#94A3B8" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Wolf Artwork Motto -->
                    <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#162032" BorderThickness="1" CornerRadius="4" Padding="6,8" Margin="0,6,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🐺" FontSize="22" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            <TextBlock Text="Different Tools." FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Text="Greater Researchers." FontSize="8" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== CENTRAL COCKPIT ==================== -->
            <Grid Grid.Column="1" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <!-- Row 1: 4 Metric / Status Cards -->
                    <RowDefinition Height="85" />
                    <!-- Row 2: Attack Surface Visualizer + Target Details -->
                    <RowDefinition Height="340" />
                    <!-- Row 3: Bottom Terminal + Findings + Evidence -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 1: Status Cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Current Target -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CURRENT TARGET" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="20" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtTargetDomain" Text="example.com" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,6,0" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="Active" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="txtTargetIp" Text="192.168.1.10" FontSize="10" Foreground="#64748B" FontFamily="Consolas" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Scan Status -->
                    <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3,0,3,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="SCAN STATUS" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="🎯" FontSize="16" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock x:Name="txtScanStatusTitle" Text="Deep Recon" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <TextBlock x:Name="txtScanStatusSubtitle" Text="Running... 73%" FontSize="9.5" Foreground="{StaticResource BrushCyan}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Progress Bar -->
                                <ProgressBar x:Name="scanProgressBar" Value="73" Maximum="100" Height="4" Background="#1E293B" Foreground="{StaticResource BrushCyan}" BorderThickness="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Findings -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3,0,3,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="FINDINGS" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                            <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center">
                                <!-- Critical -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#450A0A" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="⊘" Foreground="{StaticResource BrushCrimson}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="txtCriticalCount" Text="12" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                    <TextBlock Text="Critical" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- High -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#431407" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="⚠" Foreground="#F97316" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="txtHighCount" Text="28" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                    <TextBlock Text="High" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- Medium -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#451A03" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="◼" Foreground="{StaticResource BrushAmber}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="txtMediumCount" Text="47" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                    <TextBlock Text="Medium" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- Low -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#0C264D" CornerRadius="12" Width="24" Height="24">
                                        <TextBlock Text="🠗" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="txtLowCount" Text="93" FontWeight="Bold" FontSize="12" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                                    <TextBlock Text="Low" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Card 4: System Telemetry -->
                    <Border Grid.Column="3" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="6,0,0,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SYSTEM" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text=" · WSL2" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" Margin="4,0,2,0" />
                                <TextBlock Text=" · Kali Linux" FontSize="8.5" Foreground="#94A3B8" />
                                <Border Background="#064E3B" CornerRadius="3" Padding="3,0" Margin="6,0,0,0">
                                    <TextBlock Text="● Online" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                </Border>
                            </StackPanel>
                            <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="7.5" Foreground="#64748B" />
                                    <TextBlock x:Name="txtCpu" Text="32%" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="RAM" FontSize="7.5" Foreground="#64748B" />
                                    <TextBlock x:Name="txtRam" Text="5.1/16 GB" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="DISK" FontSize="7.5" Foreground="#64748B" />
                                    <TextBlock x:Name="txtDisk" Text="120 GB free" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 2: Attack Surface Visualizer + Target Details -->
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <!-- Visualizer Graph -->
                        <ColumnDefinition Width="6.5*" />
                        <!-- Target Details Card -->
                        <ColumnDefinition Width="3.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Attack Surface Visualizer -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <!-- Visualizer Header Tabs -->
                            <Grid Grid.Row="0" Margin="10,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⊞ ATTACK SURFACE VISUALIZER" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Border Background="#0A1828" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,4,0">
                                        <TextBlock Text="Network View" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" />
                                    </Border>
                                    <Button Content="Attack Path" Style="{StaticResource CyberButton}" Margin="0,0,4,0" Padding="8,3" FontSize="9" />
                                    <Button Content="Dependencies" Style="{StaticResource CyberButton}" Margin="0,0,4,0" Padding="8,3" FontSize="9" />
                                    <Button Content="Custom" Style="{StaticResource CyberButton}" Padding="8,3" FontSize="9" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+" Style="{StaticResource CyberButton}" Width="22" Height="22" Padding="0" Click="OnZoomInClick" Margin="0,0,3,0" />
                                    <Button Content="—" Style="{StaticResource CyberButton}" Width="22" Height="22" Padding="0" Click="OnZoomOutClick" Margin="0,0,6,0" />
                                    <Button Content="⛶" Style="{StaticResource CyberButton}" Width="22" Height="22" Padding="0" Click="OnResetGraphClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Graph Canvas Control -->
                            <controls:AttackSurfaceCanvas x:Name="graphCanvas" Grid.Row="1" />

                            <!-- Legend at Bottom -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushCyan}" Margin="0,0,4,0" />
                                    <TextBlock Text="Discovered" FontSize="8.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushCrimson}" Margin="0,0,4,0" />
                                    <TextBlock Text="Vulnerable" FontSize="8.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAmber}" Margin="0,0,4,0" />
                                    <TextBlock Text="Exploitable" FontSize="8.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushEmerald}" Margin="0,0,4,0" />
                                    <TextBlock Text="Internal" FontSize="8.5" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,4,0" />
                                    <TextBlock Text="External" FontSize="8.5" Foreground="#94A3B8" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Target Details Panel -->
                    <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="6,0,0,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="TARGET DETAILS" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />

                            <!-- Header -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🌐" FontSize="20" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel>
                                    <TextBlock x:Name="txtDetailHost" Text="example.com" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" />
                                    <TextBlock x:Name="txtDetailIp" Text="192.168.1.10" FontSize="10" Foreground="#64748B" FontFamily="Consolas" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Metadata Table -->
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,2">
                                    <TextBlock Text="Status" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="Active" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Technology" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="Nginx 1.24.0" FontSize="9.5" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="WAF" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="Not Detected" FontSize="9.5" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Open Ports" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="80, 443, 22, 3306, 6379" FontSize="9.5" FontFamily="Consolas" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="OS" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="Linux (Ubuntu)" FontSize="9.5" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Location" FontSize="9.5" Foreground="#94A3B8" />
                                    <TextBlock Text="🇺🇸 United States" FontSize="9.5" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <TextBlock Text="Risk Score" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBlock Text="8.7 / 10" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                <TextBlock Text="QUICK ACTIONS" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5" />
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Button Content="Run Nmap" Style="{StaticResource CyberButton}" Margin="1" Click="OnRunNmapAction" />
                                    <Button Content="Directory Scan" Style="{StaticResource CyberButton}" Margin="1" Click="OnDirScanAction" />
                                    <Button Content="Find Subdomains" Style="{StaticResource CyberButton}" Margin="1" Click="OnSubdomainsAction" />
                                </UniformGrid>
                                <UniformGrid Columns="3">
                                    <Button Content="Check Vulns" Style="{StaticResource CyberButton}" Margin="1" Click="OnCheckVulnsAction" />
                                    <Button Content="Exploit Search" Style="{StaticResource CyberButton}" Margin="1" Click="OnExploitSearchAction" />
                                    <Button Content="Open in Terminal" Style="{StaticResource CyberButton}" Margin="1" Click="OnOpenInTerminalAction" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 3: Bottom Split Section (Terminal + Scan Results + Evidence) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- Integrated Terminal -->
                        <ColumnDefinition Width="4*" />
                        <!-- Scan Results / Findings -->
                        <ColumnDefinition Width="3.5*" />
                        <!-- Evidence Gallery -->
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Panel 1: Integrated Terminal (WSL2 - Kali Linux) -->
                    <Border Grid.Column="0" Background="#060911" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <!-- Header Bar -->
                            <Border Grid.Row="0" Background="#0C1322" BorderBrush="#182338" BorderThickness="0,0,0,1">
                                <Grid Margin="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="INTEGRATED TERMINAL (WSL2 - Kali Linux)" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,10,0" />
                                        <Border Background="#101C30" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="kali ✕" FontSize="8.5" Foreground="{StaticResource BrushCyan}" />
                                        </Border>
                                        <TextBlock Text="+" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="—" FontSize="10" Foreground="#64748B" Margin="0,0,6,0" Cursor="Hand" />
                                        <TextBlock Text="□" FontSize="10" Foreground="#64748B" Margin="0,0,6,0" Cursor="Hand" />
                                        <TextBlock Text="✕" FontSize="10" Foreground="#64748B" Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal Text Console -->
                            <ScrollViewer x:Name="termScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,6">
                                <TextBox x:Name="txtTerminalOutput" Background="Transparent" Foreground="#A7F3D0" BorderThickness="0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="10" TextWrapping="Wrap" IsReadOnly="True" />
                            </ScrollViewer>

                            <!-- Terminal Input Line -->
                            <Border Grid.Row="2" Background="#080C16" BorderBrush="#162034" BorderThickness="0,1,0,0">
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="$ " Foreground="{StaticResource BrushCyan}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox x:Name="txtTerminalInput" Grid.Column="1" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" KeyDown="OnTerminalInputKeyDown" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Panel 2: Scan Results / Findings Tabs -->
                    <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3,0,3,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header Tabs -->
                            <Border Grid.Row="0" Background="#0C1322" BorderBrush="#182338" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Border Background="#101C30" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock Text="SCAN RESULTS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    </Border>
                                    <Button Content="VULNERABILITIES (12)" Style="{StaticResource CyberButton}" Margin="0,0,4,0" Padding="6,2" FontSize="8.5" />
                                    <Button Content="EXPLOIT DB" Style="{StaticResource CyberButton}" Margin="0,0,4,0" Padding="6,2" FontSize="8.5" />
                                    <Button Content="NOTES" Style="{StaticResource CyberButton}" Padding="6,2" FontSize="8.5" />
                                </StackPanel>
                            </Border>

                            <!-- Findings DataGrid / List -->
                            <ListBox x:Name="lstFindings" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4" MouseDoubleClick="OnFindingItemDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#090E1A" BorderBrush="#162034" BorderThickness="1" CornerRadius="4" Margin="0,1.5" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="15" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Index}" Foreground="#64748B" FontSize="9" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Severity}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#F1F5F9" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Target}" Foreground="{StaticResource BrushCyan}" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="›" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Panel 3: Evidence & Screenshots -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="4,0,0,0" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="EVIDENCE &amp; SCREENSHOTS" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="View All" FontSize="8.5" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="OnViewAllEvidenceClick" />
                            </Grid>

                            <!-- Evidence Cards Grid -->
                            <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,4,0,0">
                                <!-- Proof 1 -->
                                <Border Background="#090E1A" BorderBrush="#1A253C" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" Cursor="Hand" MouseLeftButtonDown="OnEvidenceCardClick">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#04060C" CornerRadius="3" Padding="4">
                                            <TextBlock Text="[SQLi] ' OR 1=1--&#x0a;HTTP 200 OK&#x0a;Root Admin" Foreground="{StaticResource BrushCrimson}" FontFamily="Consolas" FontSize="7.5" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="sql_injection_proof.png" FontSize="8" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="2 mins ago" FontSize="7" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Proof 2 -->
                                <Border Background="#090E1A" BorderBrush="#1A253C" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" Cursor="Hand" MouseLeftButtonDown="OnEvidenceCardClick">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#04060C" CornerRadius="3" Padding="4">
                                            <TextBlock Text="/admin/console&#x0a;System: Superuser&#x0a;Privilege: Granted" Foreground="{StaticResource BrushCyan}" FontFamily="Consolas" FontSize="7.5" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="admin_panel.png" FontSize="8" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="5 mins ago" FontSize="7" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Proof 3 -->
                                <Border Background="#090E1A" BorderBrush="#1A253C" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" Cursor="Hand" MouseLeftButtonDown="OnEvidenceCardClick">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#04060C" CornerRadius="3" Padding="4">
                                            <TextBlock Text="Index of /files/&#x0a;▸ backup.zip&#x0a;▸ secrets.json" Foreground="{StaticResource BrushAmber}" FontFamily="Consolas" FontSize="7.5" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="directory_listing.png" FontSize="8" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="8 mins ago" FontSize="7" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Proof 4 -->
                                <Border Background="#090E1A" BorderBrush="#1A253C" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" Cursor="Hand" MouseLeftButtonDown="OnEvidenceCardClick">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#04060C" CornerRadius="3" Padding="4">
                                            <TextBlock Text="uid=0(root) gid=0&#x0a;Linux 5.15.0&#x0a;# Proof Sealed" Foreground="{StaticResource BrushEmerald}" FontFamily="Consolas" FontSize="7.5" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock Text="rce_output.png" FontSize="8" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="12 mins ago" FontSize="7" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== FAR RIGHT AI ASSISTANT PANEL ==================== -->
            <Border Grid.Column="2" Background="#070B14" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,0,0,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Chat History -->
                        <RowDefinition Height="*" />
                        <!-- Quick Suggestions -->
                        <RowDefinition Height="Auto" />
                        <!-- Input Box -->
                        <RowDefinition Height="Auto" />
                        <!-- LLM Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖 AI SECURITY ASSISTANT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                        </StackPanel>
                        <Border Background="#064E3B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                            <TextBlock Text="● Online" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                        </Border>
                    </Grid>

                    <!-- Chat History -->
                    <ScrollViewer x:Name="aiChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <StackPanel x:Name="aiChatPanel">
                            <!-- Welcome bubble -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#1E293B" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <TextBlock Text="👾" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="#0E1626" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="8" Padding="10,8" MaxWidth="250">
                                    <TextBlock Text="How can I help you today?" Foreground="#E2E8F0" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Quick Suggestions -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button Content="Analyze these scan results" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                        <Button Content="Explain this vulnerability" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                        <Button Content="Suggest next steps" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                        <Button Content="Generate an exploit script" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                        <Button Content="Help me with privilege escalation" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                        <Button Content="Create a report for this target" Style="{StaticResource CyberButton}" HorizontalContentAlignment="Left" Margin="0,2" Click="OnSuggestionClick" />
                    </StackPanel>

                    <!-- Chat Input Box -->
                    <Border Grid.Row="3" Background="#0C1220" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Height="36">
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtAiInput" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" Text="Ask anything about security..." GotFocus="OnAiInputGotFocus" LostFocus="OnAiInputLostFocus" KeyDown="OnAiInputKeyDown" />
                            <Button Grid.Column="1" Content="➤" Style="{StaticResource CyberPrimaryButton}" Width="26" Height="26" Padding="0" Margin="4,0,0,0" Click="OnSendAiMessageClick" />
                        </Grid>
                    </Border>

                    <!-- LLM Footer -->
                    <TextBlock Grid.Row="4" Text="Powered by local/online LLM (Your choice)" FontSize="8" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="#04060C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DOGE v1.0.0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,14,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <TextBlock Text="● " Foreground="{StaticResource BrushEmerald}" FontSize="8" VerticalAlignment="Center" />
                        <TextBlock Text="Offline Mode" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Workspace: " FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtStatusWorkspace" Text="example.com" FontSize="9" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="🛠 Tools Ready (" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtStatusTools" Text="24" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                    <TextBlock Text=")" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="⚡ WSL2: " FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtStatusWsl" Text="kali-linux" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="🤖 AI: Local (" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtStatusAiModel" Text="llama3" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushViolet}" VerticalAlignment="Center" />
                    <TextBlock Text=")" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Quote -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="&quot;Knowledge is the ultimate exploit.&quot; — DOGE" FontSize="8.5" FontStyle="Italic" Foreground="#475569" />
            </Grid>
        </Border>
    </Grid>
</Window>
