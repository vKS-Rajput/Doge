                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Rate Limit" FontSize="9.5" Foreground="#CBD5E1" />
                                <TextBlock Text="20 req / sec" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="Scope Enforcement" FontSize="9.5" Foreground="#CBD5E1" />
                                <TextBlock Text="STRICT (Subdomains &amp; IPs)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========== VIEW 11: SCHEDULED TASKS & CRON ========== -->
                <Grid x:Name="viewTasks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="⏱ SCHEDULED AUTONOMOUS TASKS &amp; RECURRING CRON" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />

                    <!-- Schedule Task Creator Bar -->
                    <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="JOB NAME" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBox x:Name="txtTaskName" Background="#0C1220" Foreground="#CBD5E1" BorderBrush="#1C273E" Padding="6,4" FontSize="9.5" Text="Continuous Invariant Falsification" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="CRON SCHEDULE" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBox x:Name="txtTaskCron" Background="#0C1220" Foreground="{StaticResource BrushCyan}" BorderBrush="#1C273E" Padding="6,4" FontSize="9.5" Text="*/15 * * * *" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="TARGET ACTION" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" />
                                <TextBox x:Name="txtTaskAction" Background="#0C1220" Foreground="#CBD5E1" BorderBrush="#1C273E" Padding="6,4" FontSize="9.5" Text="doge hunt" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="+ Create Schedule" Style="{StaticResource CyberPrimaryButton}" Height="30" VerticalAlignment="Bottom" Click="OnCreateScheduledTaskClick" />
                        </Grid>
                    </Border>

                    <!-- Scheduled Tasks List -->
                    <Border Grid.Row="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="scheduledTasksPanel">
                                <!-- Populated dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========== VIEW 12: SKILLS & RESEARCHER FLEET ========== -->
                <Grid x:Name="viewSkills" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩 SPECIALIZED RESEARCHER FLEET &amp; SKILLS" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                        <Border Background="#121D33" CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="14 Autonomous Specialists Registered" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="skillsListPanel" Margin="0,4,0,0">
                            <!-- Populated dynamically -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========== VIEW 7: NOTEBOOK & JOURNAL ========== -->
                <Grid x:Name="viewNotebook" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📓 NOTEBOOK &amp; REPRODUCIBILITY JOURNAL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Text="· SQLite Tamper-Evident Audit Trail &amp; Operator Notes Studio" FontSize="10" Foreground="#64748B" Margin="10,2,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="320" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Automated Audit Journal -->
                        <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="AUTOMATED SYSTEM AUDIT TRAIL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
