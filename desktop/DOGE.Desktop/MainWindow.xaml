<Window x:Class="DOGE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DOGE.Desktop.Controls"
        Title="DOGE — Security Research Workstation"
        Height="960" Width="1520" MinHeight="750" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBgObsidian}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command Bar -->
            <RowDefinition Height="44" />
            <!-- Main Cockpit Body -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP COMMAND BAR ==================== -->
        <Border Grid.Row="0" Background="#080C16" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand & Target Pill -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Command Palette / Search -->
                    <ColumnDefinition Width="340" />
                    <!-- Quick Actions -->
                    <ColumnDefinition Width="*" />
                    <!-- Status Indicator & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DOGE Brand Logo & Active Target Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="🐺" FontSize="18" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="D O G E" FontFamily="Segoe UI Variable Display, Consolas, Segoe UI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Text="SECURITY RESEARCH OPERATING ENVIRONMENT" FontSize="7" FontWeight="SemiBold" Foreground="#475569" />
                    </StackPanel>

                    <!-- Active Target Scope Pill -->
                    <Border Background="#0C1524" BorderBrush="#1C2E46" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="9.5" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtTopTarget" Text="example.com" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="#064E3B" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="IN-SCOPE" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search / Command Palette Input -->
                <Border Grid.Column="1" Background="#0C1220" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Height="28" Margin="0,0,15,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" Text="Ctrl + Shift + P  Search target, CVE, invariant..." GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" KeyDown="OnSearchKeyDown" />
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="+ New Mission" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnNewTargetClick" />
                    <Button x:Name="btnStart" Content="▶  Start Loop" Style="{StaticResource CyberPrimaryButton}" Width="100" Height="26" Margin="0,0,10,0" Click="OnStartResearchClick" />
                    <!-- Autonomy Mode Pill -->
                    <Border Background="#140E26" BorderBrush="#3B1C63" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ Mode: " FontSize="9" Foreground="#94A3B8" />
                            <TextBlock x:Name="txtTopAutonomy" Text="Level 3 (Low-Risk Authorized)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushViolet}" />
                        </StackPanel>
                    </Border>
                    <!-- Human Approval Alert Badge -->
                    <Border x:Name="badgePendingApproval" Background="#3B1212" BorderBrush="{StaticResource BrushCrimson}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="OnPendingApprovalBadgeClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="9" Foreground="{StaticResource BrushCrimson}" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtPendingApprovalCount" Text="1 ACTION PENDING APPROVAL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- WSL Status Pill and Custom Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#07191B" BorderBrush="#0C3B3C" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● " FontSize="8" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center" />
                            <TextBlock Text="WSL2 Kali Ready" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Custom Window Buttons -->
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnMinimizeClick" Margin="0,0,2,0" />
                        <Button Content="□" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnMaximizeClick" Margin="0,0,2,0" />
                        <Button Content="✕" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnCloseClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN COCKPIT BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Navigation Rail (180px) -->
                <ColumnDefinition Width="180" />
                <!-- Central Workspace (*) -->
                <ColumnDefinition Width="*" />
                <!-- Right Inspector / AI Assistant (310px) -->
                <ColumnDefinition x:Name="colRightPanel" Width="310" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION RAIL ==================== -->
            <Border Grid.Column="0" Background="#060912" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="6,8,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="navPanel">
                            <!-- Group 1: EXPLORATION -->
                            <TextBlock Text="EXPLORATION" FontSize="8" FontWeight="Bold" Foreground="#475569" Margin="8,4,0,4" />

                            <Border x:Name="navMission" Tag="Mission" Background="#0E2238" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="🚀" Foreground="{StaticResource BrushCyan}" FontSize="11.5" Margin="0,0,8,0" />
                                    <TextBlock Text="Mission Cockpit" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navSurface" Tag="Surface" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="🌐" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Attack Surface" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navResearch" Tag="Research" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="⚡" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Research Frontier" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Group 2: MODELS & EXPERIMENTS -->
                            <TextBlock Text="MODELS &amp; ENGINE" FontSize="8" FontWeight="Bold" Foreground="#475569" Margin="8,10,0,4" />

                            <Border x:Name="navWorldModel" Tag="WorldModel" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="🧠" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="World Model" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navExperiments" Tag="Experiments" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="🧪" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Experiments" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Group 3: VALIDATION & PROOF -->
                            <TextBlock Text="VALIDATION &amp; PROOF" FontSize="8" FontWeight="Bold" Foreground="#475569" Margin="8,10,0,4" />

                            <Border x:Name="navFindings" Tag="Findings" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <Grid Margin="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                        <TextBlock Text="Findings" Foreground="#94A3B8" FontSize="11" />
                                    </StackPanel>
                                    <Border Background="#450A0A" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                        <TextBlock Text="12" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="navEvidence" Tag="Evidence" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <Grid Margin="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📜" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                        <TextBlock Text="Evidence Studio" Foreground="#94A3B8" FontSize="11" />
                                    </StackPanel>
                                    <Border Background="#0C264D" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                        <TextBlock Text="4" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Group 4: LABORATORY -->
                            <TextBlock Text="LABORATORY" FontSize="8" FontWeight="Bold" Foreground="#475569" Margin="8,10,0,4" />

                            <Border x:Name="navTerminal" Tag="Terminal" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="💻" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="WSL2 Terminal" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navToolbox" Tag="Toolbox" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="🧰" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Security Toolbox" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navAutonomy" Tag="Autonomy" Background="Transparent" CornerRadius="5" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="⚙" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="Policy &amp; Autonomy" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Workstation Identity Card -->
                    <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#151E30" BorderThickness="1" CornerRadius="5" Padding="8,8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="DOGE OPERATING CORE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                            <TextBlock Text="Autonomous Security Workstation" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Offline-First · Cryptographic Proof" FontSize="7" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== CENTRAL WORKSPACE (VIEWS) ==================== -->
            <Grid Grid.Column="1" Margin="10,8,10,8">

                <!-- ========== VIEW 1: MISSION (THE COCKPIT) ========== -->
                <Grid x:Name="viewMission" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Top 4 Metric KPI Cards -->
                        <RowDefinition Height="76" />
                        <!-- Middle Split: Attack Surface Canvas (60%) + Hypothesis Invariant (40%) -->
                        <RowDefinition Height="*" />
                        <!-- Bottom: Live Laboratory Activity Stream -->
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <!-- Top 4 Metric Cards -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Target Posture -->
                        <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,5,0" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="TARGET POSTURE" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="18" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="txtTargetDomain" Text="example.com" FontSize="12.5" FontWeight="Bold" Foreground="#F1F5F9" />
                                        <TextBlock x:Name="txtTargetIp" Text="192.168.1.10 · Nginx 1.24.0" FontSize="9" Foreground="#64748B" FontFamily="Consolas" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Autonomous Research Loop -->
                        <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3,0,3,0" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="AUTONOMOUS RESEARCH LOOP" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="⚡" FontSize="14" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel>
                                            <TextBlock x:Name="txtScanStatusTitle" Text="Standby · Ready" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" />
                                            <TextBlock x:Name="txtScanStatusSubtitle" Text="Research Frontier ΔI = 0.84" FontSize="9" Foreground="{StaticResource BrushCyan}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar x:Name="scanProgressBar" Value="100" Maximum="100" Height="3" Background="#1E293B" Foreground="{StaticResource BrushCyan}" BorderThickness="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Findings -->
                        <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3,0,3,0" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="VERIFIED FINDINGS" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="12" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushCrimson}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Critical" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="28" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Center" />
                                        <TextBlock Text="High" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="47" FontWeight="Bold" FontSize="13" Foreground="#FBBF24" HorizontalAlignment="Center" />
                                        <TextBlock Text="Med" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="93" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                        <TextBlock Text="Low" FontSize="7.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Card 4: Laboratory Substrate Telemetry -->
                        <Border Grid.Column="3" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="5,0,0,0" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LABORATORY SUBSTRATE" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text=" · WSL2 Kali" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" Margin="4,0,0,0" />
                                </StackPanel>
                                <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="CPU" FontSize="7.5" Foreground="#64748B" />
                                        <TextBlock x:Name="txtCpu" Text="28%" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="RAM" FontSize="7.5" Foreground="#64748B" />
                                        <TextBlock x:Name="txtRam" Text="5.1/16G" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TOOLS" FontSize="7.5" Foreground="#64748B" />
                                        <TextBlock x:Name="txtDisk" Text="24 Ready" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Middle Split: Attack Surface Radar + Research Invariant -->
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Attack Surface Radar -->
                        <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <!-- Header Tabs -->
                                <Grid Grid.Row="0" Margin="10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⊞ ATTACK SURFACE RADAR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Text="Interactive Bézier Graph" FontSize="8.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="+" Style="{StaticResource CyberButton}" Width="20" Height="20" Padding="0,0,0,0" Click="OnZoomInClick" Margin="0,0,2,0" />
                                        <Button Content="—" Style="{StaticResource CyberButton}" Width="20" Height="20" Padding="0,0,0,0" Click="OnZoomOutClick" Margin="0,0,4,0" />
                                        <Button Content="⛶" Style="{StaticResource CyberButton}" Width="20" Height="20" Padding="0,0,0,0" Click="OnResetGraphClick" />
                                    </StackPanel>
                                </Grid>

                                <!-- Canvas -->
                                <controls:AttackSurfaceCanvas x:Name="graphCanvas" Grid.Row="1" />

                                <!-- Legend -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushCyan}" Margin="0,0,3,0" />
                                    <TextBlock Text="Discovered" FontSize="8" Foreground="#94A3B8" Margin="0,0,10,0" />
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushCrimson}" Margin="0,0,3,0" />
                                    <TextBlock Text="Vulnerable" FontSize="8" Foreground="#94A3B8" Margin="0,0,10,0" />
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushAmber}" Margin="0,0,3,0" />
                                    <TextBlock Text="Exploitable" FontSize="8" Foreground="#94A3B8" Margin="0,0,10,0" />
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushEmerald}" Margin="0,0,3,0" />
                                    <TextBlock Text="Internal Service" FontSize="8" Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: Active Scientific Invariant & Experiment Candidate -->
                        <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="5,0,0,0" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="ACTIVE RESEARCH INVARIANT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    <TextBlock Text="Formal Hypothesis &amp; Falsification Synthesis" FontSize="8" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Hypothesis Box -->
                                        <Border Background="#090E1A" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Hypothesis H-184" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" FontSize="11" />
                                                    <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                                        <TextBlock Text="High Priority" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                                    </Border>
