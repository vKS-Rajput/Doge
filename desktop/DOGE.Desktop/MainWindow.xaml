<Window x:Class="DOGE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DOGE.Desktop.Controls"
        Title="DOGE — Security Research Workstation"
        Height="960" Width="1520" MinHeight="750" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBgObsidian}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command Bar -->
            <RowDefinition Height="44" />
            <!-- Main Cockpit Body -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP COMMAND BAR ==================== -->
        <Border Grid.Row="0" Background="#080C16" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand & Target Pill -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Command Palette / Search -->
                    <ColumnDefinition Width="340" />
                    <!-- Quick Actions -->
                    <ColumnDefinition Width="*" />
                    <!-- Status Indicator & Window Controls -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DOGE Brand Logo & Active Project / Target Pills -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🐺" FontSize="20" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="D O G E" FontFamily="Segoe UI Variable Display, Consolas, Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushCyan}" />
                        <TextBlock Text="SECURITY RESEARCH OPERATING SYSTEM" FontSize="8" FontWeight="SemiBold" Foreground="#475569" />
                    </StackPanel>

                    <!-- Active Project Workspace Folder Pill -->
                    <Border x:Name="borderProjectPill" Background="#0C1524" BorderBrush="#1C2E46" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip="Active Project Workspace Folder (Click to Select / Create Folder)" MouseLeftButtonDown="OnProjectPillClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="11" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtProjectPill" Text="No Project (Click to Open)" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </StackPanel>
                    </Border>

                    <!-- Active Target Scope Pill -->
                    <Border x:Name="borderTargetPill" Background="#0C1524" BorderBrush="#1C2E46" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Cursor="Hand" ToolTip="Active Target Scope (Click to Configure)" MouseLeftButtonDown="OnTargetPillClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="11" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtTopTarget" Text="No Target Configured" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border x:Name="badgeTargetStatus" Background="#1E293B" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtTargetStatus" Text="STANDBY" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search / Command Palette Input -->
                <Border Grid.Column="1" Background="#0C1220" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Height="28" Margin="0,0,15,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txtSearch" Grid.Column="1" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="10.5" VerticalAlignment="Center" Text="Ctrl + Shift + P  Search target, CVE, invariant..." GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" KeyDown="OnSearchKeyDown" />
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="+ New Mission" Style="{StaticResource CyberButton}" Margin="0,0,6,0" Click="OnNewTargetClick" />
                    <Button x:Name="btnStart" Content="▶  Start Loop" Style="{StaticResource CyberPrimaryButton}" Width="100" Height="26" Margin="0,0,10,0" Click="OnStartResearchClick" />
                    <!-- Autonomy Mode Pill -->
                    <Border Background="#140E26" BorderBrush="#3B1C63" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ Mode: " FontSize="9" Foreground="#94A3B8" />
                            <TextBlock x:Name="txtTopAutonomy" Text="Level 3 (Low-Risk Authorized)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushViolet}" />
                        </StackPanel>
                    </Border>
                    <!-- Human Approval Alert Badge -->
                    <Border x:Name="badgePendingApproval" Background="#3B1212" BorderBrush="{StaticResource BrushCrimson}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="OnPendingApprovalBadgeClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="9" Foreground="{StaticResource BrushCrimson}" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtPendingApprovalCount" Text="1 ACTION PENDING APPROVAL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- WSL Status Pill and Custom Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#07191B" BorderBrush="#0C3B3C" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● " FontSize="8" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center" />
                            <TextBlock Text="WSL2 Kali Ready" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Custom Window Buttons -->
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnMinimizeClick" Margin="0,0,2,0" />
                        <Button Content="□" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnMaximizeClick" Margin="0,0,2,0" />
                        <Button Content="✕" Style="{StaticResource CyberButton}" Width="26" Height="22" Padding="0,0,0,0" Click="OnCloseClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN COCKPIT BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Left Sidebar Navigation Rail -->
                <ColumnDefinition x:Name="colLeftRail" Width="210" MinWidth="170" MaxWidth="380" />
                <!-- Col 1: Splitter between Left Rail & Center Workspace -->
                <ColumnDefinition Width="4" />
                <!-- Col 2: Central Workspace (*) -->
                <ColumnDefinition x:Name="colCenterWorkspace" Width="*" MinWidth="420" />
                <!-- Col 3: Splitter between Center Workspace & Right Panel -->
                <ColumnDefinition Width="4" />
                <!-- Col 4: Right Inspector / AI Assistant -->
                <ColumnDefinition x:Name="colRightPanel" Width="330" MinWidth="240" MaxWidth="650" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION RAIL (COL 0) ==================== -->
            <Border Grid.Column="0" Background="#060912" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="6,8,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="navPanel">
                            <!-- PRIMARY RESEARCH WORKSPACE -->
                            <TextBlock Text="RESEARCH WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="8,4,0,5" />

                            <Border x:Name="navHome" Tag="Home" Background="#0E2238" BorderBrush="{StaticResource BrushCyan}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🏠" Foreground="{StaticResource BrushCyan}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Home (Briefing)" FontWeight="SemiBold" Foreground="{StaticResource BrushCyan}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navMissions" Tag="Missions" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🎯" Foreground="#64748B" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Missions &amp; Scope" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navResearch" Tag="Research" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⚡" Foreground="#64748B" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Research &amp; Hypotheses" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navTarget" Tag="Target" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="🌐" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                    <TextBlock Text="Target Topology" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navFindings" Tag="Findings" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <Grid Margin="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                        <TextBlock Text="Findings" Foreground="#94A3B8" FontSize="12" />
                                    </StackPanel>
                                    <Border Background="#450A0A" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtNavFindingsCount" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="navEvidence" Tag="Evidence" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <Grid Margin="8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📜" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                        <TextBlock Text="Evidence Studio" Foreground="#94A3B8" FontSize="12" />
                                    </StackPanel>
                                    <Border Background="#0C264D" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="txtNavEvidenceCount" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="navTerminal" Tag="Terminal" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="💻" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                    <TextBlock Text="WSL2 Terminal" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="navNotebook" Tag="Notebook" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="📓" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                    <TextBlock Text="Notebook &amp; Journal" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- ENGINEERING & CONFIGURATION -->
                            <TextBlock Text="SYSTEM &amp; FLEET" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="8,14,0,5" />

                            <Border x:Name="navSettings" Tag="Settings" Background="Transparent" CornerRadius="5" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="OnNavClick">
                                <StackPanel Orientation="Horizontal" Margin="8,7">
                                    <TextBlock Text="⚙" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,0" />
                                    <TextBlock Text="Engineering &amp; Fleet" Foreground="#94A3B8" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Workstation Identity Card -->
                    <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#151E30" BorderThickness="1" CornerRadius="5" Padding="8,8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="DOGE OPERATING CORE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" HorizontalAlignment="Center" />
                            <TextBlock Text="Autonomous Security Workstation" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Offline-First · Deterministic EIG Engine" FontSize="7.5" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== RESIZABLE SPLITTER (COL 1) ==================== -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#0C1220" Cursor="SizeWE" ShowsPreview="False" />

            <!-- ==================== CENTRAL WORKSPACE (VIEWS) (COL 2) ==================== -->
            <Grid Grid.Column="2" Margin="8,6,8,6">

                <!-- ========== VIEW 1: HOME (BRIEFING & LAUNCHER) ========== -->
                <Grid x:Name="viewHome" Visibility="Visible">
                    <!-- State A: Empty Start Box (When No Project is Open) -->
                    <Grid x:Name="panelNoProject" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border MaxWidth="800" Margin="20,16,20,24" Background="#090E1A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="28,24">
                                <StackPanel>
                                    <!-- Title Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🐺" FontSize="28" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DOGE Autonomous Security Workstation" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                            <TextBlock Text="Offline-First · Invariant Falsification · Cryptographic Attestation" FontSize="11.5" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Create or open a dedicated project folder to begin your engagement. All discovery graphs, invariants, counterexamples, proof bundles, and terminal logs will be deterministically isolated in this directory." 
                                               FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,20" LineHeight="19" />

                                    <!-- Step 1: Project Folder Card -->
                                    <Border Background="#0C1220" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="📁 1. PROJECT WORKSPACE DIRECTORY (REQUIRED)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4" />
                                            <TextBlock Text="Select a local folder on your workstation where all project artifacts, proofs, and logs will reside:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtStartProjectFolder" Grid.Column="0" Style="{StaticResource CyberTextBox}" FontSize="12.5" Height="34" Margin="0,0,8,0" Text="C:\Users\k8659\OneDrive\Desktop\Doge\projects\Target_Alpha" />
                                                <Button Grid.Column="1" Content="📂 Browse Folder..." Style="{StaticResource CyberButton}" Height="34" Padding="14,0" FontSize="12" Click="OnBrowseFolderClick" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 2: Target Scope Card -->
                                    <Border Background="#0C1220" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="🌐 2. REAL-WORLD TARGET APPLICATION &amp; SCOPE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4" />
                                            <TextBlock Text="Specify the target URL, hostname, CIDR, or IP (e.g., https://app.example.local or 192.168.1.1):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                                            <TextBox x:Name="txtStartTargetUrl" Style="{StaticResource CyberTextBox}" FontSize="12.5" Height="34" Text="https://target.local" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 3: Project Profile & Options -->
                                    <Border Background="#0C1220" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="⚡ 3. ENGAGEMENT PROFILE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,4" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="rbProfileFull" Grid.Column="0" Content="Autonomous Invariant Research (EIG Arbitrated)" IsChecked="True" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,6" />
                                                <RadioButton x:Name="rbProfileRecon" Grid.Column="1" Content="Edge Recon &amp; Attack Surface Mapping Only" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="⚡ Launch Project Workspace" Style="{StaticResource CyberPrimaryButton}" Height="38" FontSize="13" FontWeight="Bold" Margin="0,0,10,0" Click="OnInitializeProjectClick" />
                                        <Button Grid.Column="1" Content="📂 Open Existing..." Style="{StaticResource CyberButton}" Height="38" Padding="14,0" FontSize="12" Click="OnOpenExistingProjectClick" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- State B: Active Morning Briefing Cockpit (When Project is Active) -->
                    <Grid x:Name="panelActiveHome" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,10,14,20">
                                <!-- Top Status Row: 4 Metric Cards -->
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <!-- Card 1: Active Target -->
                                    <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE TARGET SCOPE" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock x:Name="txtHomeTarget" Text="No Target Loaded" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#064E3B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock x:Name="txtHomeStatus" Text="STANDBY" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                                </Border>
                                                <TextBlock Text="WSL2 Kali Lab" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Discovered Surface -->
                                    <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="WHAT DOGE KNOWS" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="txtHomeHostsCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" />
                                                <TextBlock Text=" Hosts · " FontSize="10" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,4,1" />
                                                <TextBlock x:Name="txtHomeEndpointsCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                                <TextBlock Text=" Endpoints" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                            </StackPanel>
                                            <TextBlock x:Name="txtHomeSurfaceDetails" Text="0 Parameters · 0 Technologies mapped" FontSize="8" Foreground="#64748B" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Research Loop State -->
                                    <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="AUTONOMOUS ENGINE" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                            <TextBlock x:Name="txtHomeLoopState" Text="Standby · Paused" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushViolet}" Margin="0,4,0,2" />
                                            <TextBlock x:Name="txtHomeBudgetRatio" Text="Budget: 5,000 requests · 20 req/s" FontSize="8" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Proven Findings -->
                                    <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="VERIFIED FINDINGS" FontSize="8" FontWeight="Bold" Foreground="#64748B" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                                <TextBlock x:Name="txtHomeProvenCount" Text="0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" />
                                                <TextBlock Text=" Proven" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" VerticalAlignment="Bottom" Margin="4,0,8,1" />
                                                <TextBlock x:Name="txtHomeCandidateCount" Text="(0 Candidates)" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                            </StackPanel>
                                            <TextBlock Text="Attested with HMAC-SHA256 Merkle proofs" FontSize="8" Foreground="#64748B" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Human Approval Alert (Visible when gate is pending) -->
                                <Border x:Name="borderHomeGateAlert" Background="#3A0D16" BorderBrush="{StaticResource BrushCrimson}" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="3,0,3,10" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="⚠️ HUMAN APPROVAL REQUIRED — AUTONOMOUS LOOP PAUSED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushCrimson}" />
                                            <TextBlock x:Name="txtHomeGateAlertText" Text="A state-changing invariant falsification probe requires explicit operator authorization." FontSize="9.5" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
