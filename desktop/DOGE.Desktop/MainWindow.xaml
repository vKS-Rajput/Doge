                                </StackPanel>
                            </Border>

                            <TextBlock Text="RESOURCE &amp; RATE CEILINGS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,6,0,6" />
