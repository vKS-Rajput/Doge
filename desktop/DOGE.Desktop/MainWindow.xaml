                                                <ComboBoxItem Content="Observation" />
                                                <ComboBoxItem Content="Vulnerability" />
                                                <ComboBoxItem Content="Credential" />
                                                <ComboBoxItem Content="Architecture" />
                                                <ComboBoxItem Content="TODO" />
