                                            <Button Grid.Column="2" Content="💾 Save Note" Style="{StaticResource CyberPrimaryButton}" Height="26" Padding="12,0" FontSize="10" Click="OnSaveOperatorNoteClick" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Notes List -->
                                <ListBox x:Name="lstOperatorNotes" Grid.Row="2" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#090E1A" BorderBrush="#162034" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="10,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Category}" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Author}" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center" />
