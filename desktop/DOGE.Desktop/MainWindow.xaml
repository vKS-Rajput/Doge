                                </Grid>

                                <ListBox x:Name="lstNotebookJournal" Grid.Row="1" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#090E1A" BorderBrush="#162034" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="10,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Background="#121E36" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Type}" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="9.5" Foreground="#F1F5F9" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding OccurredAt}" FontFamily="Consolas" FontSize="8" Foreground="#64748B" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Action}" FontSize="8.5" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Vertical Splitter -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#0C1220" Cursor="SizeWE" ShowsPreview="False" />

                        <!-- Right Column: Operator Notes Studio -->
                        <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="OPERATOR RESEARCH NOTES STUDIO" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                    <TextBlock Text="Record findings, manual credentials, or invariant observations" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Note Composer -->
                                <Border Grid.Row="1" Background="#070B16" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBox x:Name="txtOperatorNoteInput" Style="{StaticResource CyberTextBox}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Category: " FontSize="9" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
