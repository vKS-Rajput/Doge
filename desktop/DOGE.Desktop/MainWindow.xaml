                            </StackPanel>
                        </Border>

                        <!-- Tool 4: Dalfox -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dalfox" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" FontSize="11.5" />
                                    <Border Background="#064E3B" CornerRadius="3" Padding="3,1" Margin="6,0,0,0">
                                        <TextBlock Text="INSTALLED" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Parameter analysis &amp; XSS scanner" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,8" />
                                <Button Content="Scan Parameters" Style="{StaticResource CyberButton}" Click="OnToolDalfoxClick" />
                            </StackPanel>
                        </Border>

                        <!-- Tool 5: Subfinder -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Subfinder" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" FontSize="11.5" />
                                    <Border Background="#064E3B" CornerRadius="3" Padding="3,1" Margin="6,0,0,0">
                                        <TextBlock Text="INSTALLED" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Fast passive subdomain enumerator" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,8" />
                                <Button Content="Find Subdomains" Style="{StaticResource CyberButton}" Click="OnToolSubfinderClick" />
                            </StackPanel>
                        </Border>

                        <!-- Tool 6: SQLmap -->
                        <Border Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Margin="3" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SQLmap" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" FontSize="11.5" />
                                    <Border Background="#064E3B" CornerRadius="3" Padding="3,1" Margin="6,0,0,0">
                                        <TextBlock Text="INSTALLED" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Automatic SQL injection tester" FontSize="8.5" Foreground="#64748B" Margin="0,2,0,8" />
                                <Button Content="Test SQL Invariant" Style="{StaticResource CyberButton}" Click="OnToolSqlmapClick" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Toolbox Execution Log -->
                    <Border Grid.Row="2" Background="#04060C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="TOOL EXECUTION OUTPUT (WSL2 STREAM)" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="txtToolOutput" Background="Transparent" Foreground="#A7F3D0" BorderThickness="0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" IsReadOnly="True" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== VIEW 10: POLICY & AUTONOMY ========== -->
                <Grid x:Name="viewAutonomy" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚙ AUTONOMY GATES &amp; DETERMINISTIC SAFETY POLICY" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" VerticalAlignment="Center" />

                    <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="AUTONOMY POLICY LEVEL (1 to 5)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,6" />
